# Local Development Environment Configuration
# Use this file when running with KinD local Kubernetes cluster

# Enable local development mode
LOCAL_DEV=true

# Local domain for MCP servers (handled by nginx-ingress in KinD)
MCP_DOMAIN=mcp.localhost
MCP_HOSTING_DOMAIN=mcp.localhost

# Local container registry (no auth required)
CONTAINER_REGISTRY=localhost:5000

# Skip TLS for local development (no cert-manager)
SKIP_TLS=true

# Kubernetes namespace for MCP servers. The backend creates Deployments,
# Services and Secrets in it directly via the Kubernetes API - apply
# k8s/mcp-servers first so the namespace and RBAC exist.
K8S_NAMESPACE=mcp-servers

# Note: The following are NOT needed for LOCAL_DEV mode:
# - GITHUB_TOKEN (not needed for the local registry)
# - GHCR_* variables (using local registry instead)
