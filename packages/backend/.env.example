# =============================================================================
# MCP Everything Backend - Environment Configuration
#
# The backend loads `.env` from its own working directory
# (ConfigModule.forRoot({ envFilePath: '.env' }) in src/app.module.ts), so when
# running `npm run dev:backend` from the repo root the ROOT .env is used.
# Keep this file in sync with the root .env.example - the root file is the
# canonical, fully documented list.
#
# Only variables the code ACTUALLY reads are listed here (verified against
# process.env.* and ConfigService.get() usages in src/).
#
#   [REQUIRED] backend does not work without it
#   [OPTIONAL] feature-specific, has a default or disables a feature
# =============================================================================

# --- Core (REQUIRED) --------------------------------------------------------
# [REQUIRED] Anthropic API key (AnthropicService in src/ai throws on startup
# without it - it is the only place a Claude client is constructed)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# [OPTIONAL] Model for reasoning / synthesis / code generation
ANTHROPIC_MODEL=claude-sonnet-5
# [OPTIONAL] Cheaper model for classification / intent detection
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
# [OPTIONAL] Default output-token cap per call (code generation raises it to 64k)
ANTHROPIC_MAX_TOKENS=8192
# [OPTIONAL] Max simultaneous in-flight Anthropic requests
ANTHROPIC_MAX_CONCURRENCY=4
# [OPTIONAL] Per-call timeout in milliseconds
ANTHROPIC_TIMEOUT_MS=120000
# [OPTIONAL] SDK retry attempts (exponential backoff on 429 / 5xx / network)
ANTHROPIC_MAX_RETRIES=3
# [OPTIONAL] (true) LLM-as-judge quality gate in the pipeline's refine step -
# runs after tool tests + protocol validation pass. false = one fewer call.
PIPELINE_QUALITY_GATE=true
# [OPTIONAL] (0.75) Intent confidence floor. Below this - or with no
# identifiable target service/API - the pipeline asks instead of researching.
PIPELINE_INTENT_CONFIDENCE_MIN=0.75
# [REQUIRED] GitHub PAT - scopes: repo, gist, read:user (+ write:packages for GHCR)
GITHUB_TOKEN=ghp_your-token-here
# [REQUIRED] JWT signing secret (>= 32 chars)
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long

# --- Database (REQUIRED - these exact DATABASE_* names are what code reads) --
# Values match docker/docker-compose.dev.yml (`npm run dev:up`).
# Root docker-compose.yml uses postgres/postgres instead.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mcp
DATABASE_PASSWORD=mcp_secret
DATABASE_NAME=mcp_everything

# --- Application (OPTIONAL) -------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:4200

# --- Authentication (OPTIONAL / refresh secret required for refresh flow) ---
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your-secure-refresh-secret-different-from-jwt-secret
JWT_REFRESH_EXPIRY=7d
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# [OPTIONAL, but required for per-user GitHub repo listing] 32-byte key (64 hex
# chars) used to encrypt each user's GitHub OAuth access token at rest with
# AES-256-GCM (src/common/token-encryption/token-encryption.service.ts).
# Deliberately a SEPARATE secret from JWT_SECRET/JWT_REFRESH_SECRET so it can
# be rotated independently and a leak of one doesn't expose the other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset (or not exactly 64 hex chars), the backend does NOT crash - GitHub
# OAuth login still works, but the access token is not persisted, so per-user
# repository listing falls back to the server GITHUB_TOKEN (or is unavailable).
TOKEN_ENCRYPTION_KEY=

# --- Research (OPTIONAL - web search is skipped when unset) -----------------
TAVILY_API_KEY=tvly-your-key-here

# --- Email (OPTIONAL - logged to console when NODE_ENV=development) --------
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@mcp-everything.com
EMAIL_FROM_NAME=MCP Everything

# --- Stripe / billing (OPTIONAL) -------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_FREE=price_xxxxx
STRIPE_PRICE_PRO=price_xxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxx

# --- MCP server hosting (OPTIONAL - K8s hosting feature only) --------------
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=4eyedengineer
# 'user' or 'org' - which GitHub Packages API owns GHCR_OWNER's images.
# Auto-detected when unset; the wrong choice 404s and image cleanup silently
# never happens.
# GHCR_OWNER_TYPE=org
GHCR_REPO=mcp-servers
# Public origin of THIS backend. Every hosted MCP server is reached through the
# gateway on this one origin, path-addressed by server id:
#   <MCP_GATEWAY_PUBLIC_URL>/api/hosting/servers/<serverId>/mcp
# It is written into each hosted server's endpoint_url at deploy time and is
# what users point their MCP client (or `mcp-connect`) at. Must be reachable by
# clients, so in production this is the public API hostname, not localhost.
MCP_GATEWAY_PUBLIC_URL=http://localhost:3000
# Legacy: the wildcard domain the per-server-subdomain scheme would have used.
# Nothing routes it (no Ingress is generated); retained only for the k8s
# manifests' metadata and the down-migration.
MCP_HOSTING_DOMAIN=mcp.example.com
# Namespace hosted servers are created in. Apply k8s/mcp-servers first - it
# creates the namespace and the RBAC the backend's ServiceAccount needs.
# Kubernetes credentials come from KUBECONFIG / ~/.kube/config, falling back
# to the in-cluster ServiceAccount.
K8S_NAMESPACE=mcp-servers
# [OPTIONAL] imagePullSecret in K8S_NAMESPACE, for a private registry.
# K8S_IMAGE_PULL_SECRET=ghcr-pull-secret
# [OPTIONAL] (10000) reconciler poll interval, ms.
# K8S_RECONCILE_INTERVAL_MS=10000
# [OPTIONAL] (true) set 'false' to disable status reconciliation.
# K8S_RECONCILE_ENABLED=false
# Local KinD workflow (see ../../.env.local.example and scripts/kind/setup.sh)
# LOCAL_DEV=true
# [OPTIONAL] (kubernetes) 'docker-run' runs Host on Cloud deploys as real
# local Docker containers (build + run + verify the MCP stdio handshake)
# instead of registry-push + apply-to-cluster. No registry or K8s cluster
# needed. See DEPLOYMENT.md "local hosting on WSL2".
# HOSTING_MODE=docker-run
# [OPTIONAL] (docker) docker CLI path/name - set this if `docker` isn't on
# PATH (e.g. WSL2 with only Windows Docker Desktop's client reachable via
# the Windows filesystem mount).
# DOCKER_BIN=/mnt/c/Program Files/Docker/Docker/resources/bin/docker.exe
# [OPTIONAL] (15000) ms to wait for the initialize/tools-list MCP handshake
# against a freshly-started HOSTING_MODE=docker-run container.
# MCP_HANDSHAKE_TIMEOUT_MS=15000

# --- Marketplace admin (OPTIONAL - interim mechanism) -----------------------
# Comma-separated, case-insensitive allowlist of emails allowed to call the
# marketplace admin endpoints (PATCH admin/servers/:id). Interim: the User
# entity has no `role` column and no RolesGuard exists elsewhere to reuse.
ADMIN_USER_EMAILS=

# --- Health probe / misc (OPTIONAL) ---------------------------------------
# Only used by the /api/v1/health Redis check
REDIS_HOST=localhost
REDIS_PORT=6379
# Read by dockerode for MCP server test containers
DOCKER_HOST=unix:///var/run/docker.sock

# --- Generated servers (OPTIONAL) -------------------------------------------
# [OPTIONAL] (<cwd>/generated-servers) Directory generated MCP server files are
# written to and read from (pipeline.service.ts, deployment.service.ts,
# local-docker-validator.provider.ts). In the production container image cwd
# is /app, and the Dockerfile provisions /app/generated-servers as writable by
# the nestjs user - do not point this outside of /app in that image.
GENERATED_SERVERS_DIR=./generated-servers

# =============================================================================
# NOT READ BY THE BACKEND (documented so they are not set by mistake):
#   POSTGRES_* (container-only), DATABASE_URL, REDIS_URL,
#   DATABASE_SSL / DATABASE_SYNCHRONIZE / DATABASE_LOGGING,
#   ANTHROPIC_TEMPERATURE (rejected by current Claude models; note that
#     ANTHROPIC_MODEL / ANTHROPIC_SMALL_MODEL / ANTHROPIC_MAX_TOKENS *are* read),
#   GITHUB_BASE_URL, DOCKER_REGISTRY_URL, BUILD_TIMEOUT, MAX_CONCURRENT_BUILDS,
#   DEFAULT_GIST_VISIBILITY, MAX_GIST_SIZE, RATE_LIMIT_TTL, RATE_LIMIT_MAX,
#   JWT_EXPIRES_IN, CORS_ORIGINS, STRIPE_PUBLISHABLE_KEY,
#   CONTAINER_REGISTRY, MCP_DOMAIN, SKIP_TLS
# =============================================================================
