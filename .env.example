# =============================================================================
# MCP Everything - Environment Configuration
# Copy this file to .env and fill in the required values.
#
# IMPORTANT: This file lists ONLY the variables the code actually reads
# (verified by grepping process.env.* and ConfigService.get() in
# packages/backend/src). Variables the backend does NOT read are listed at the
# bottom under "NOT READ BY THE BACKEND" so nobody wastes time setting them.
#
# Legend:
#   [REQUIRED]  the backend will not work (or will crash) without it
#   [OPTIONAL]  feature-specific; has a safe default or disables a feature
# =============================================================================


# =============================================================================
# CORE (REQUIRED)
# =============================================================================

# [REQUIRED] Anthropic API key - AnthropicService (src/ai) throws on startup
# without it. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# [OPTIONAL] Model used for reasoning, synthesis and code generation.
ANTHROPIC_MODEL=claude-sonnet-5
# [OPTIONAL] Cheaper model used for classification / intent detection.
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
# [OPTIONAL] Default output-token cap per call (callers may raise it, e.g. code
# generation uses 64k).
ANTHROPIC_MAX_TOKENS=8192
# [OPTIONAL] Max simultaneous in-flight Anthropic requests (semaphore).
ANTHROPIC_MAX_CONCURRENCY=4
# [OPTIONAL] Per-call timeout in milliseconds.
ANTHROPIC_TIMEOUT_MS=120000
# [OPTIONAL] SDK retry attempts (exponential backoff on 429 / 5xx / network).
ANTHROPIC_MAX_RETRIES=3
# [OPTIONAL] (true) LLM-as-judge quality gate in the generation pipeline's
# refine step. It runs only after Docker tool tests and MCP protocol validation
# already passed, and catches what running cannot: placeholder tool bodies,
# truncated files, planned-but-missing tools. Set to false to skip it (one
# fewer model call per successful generation).
PIPELINE_QUALITY_GATE=true
# [OPTIONAL] (0.75) Minimum intent confidence required before the pipeline
# starts spending money. Below this - or when the request names no identifiable
# target service/API - it asks a clarifying question instead of researching.
# Guards against the failure mode where a vague request ("an MCP server for my
# stuff") is confidently researched as some *invented* service and burns every
# refinement iteration. Lower it to ask fewer questions, raise it to ask more.
PIPELINE_INTENT_CONFIDENCE_MIN=0.75

# [REQUIRED] GitHub Personal Access Token - repository analysis, gist/repo
# deployment, GHCR pushes and GitOps commits all use it.
# Required scopes: repo, gist, read:user (+ write:packages for GHCR hosting)
GITHUB_TOKEN=ghp_xxxxx

# [REQUIRED in any shared/production environment] JWT signing secret (>= 32 chars)
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars


# =============================================================================
# DATABASE (REQUIRED - values below are also the code's built-in fallbacks
# except for user/password)
# The backend reads these DATABASE_* names (packages/backend/src/app.module.ts).
# Values below match docker/docker-compose.dev.yml (`npm run dev:up`).
# If you use the root docker-compose.yml stack instead, use postgres/postgres.
# =============================================================================

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mcp
DATABASE_PASSWORD=mcp_secret
DATABASE_NAME=mcp_everything


# =============================================================================
# APPLICATION (OPTIONAL - defaults in parentheses)
# =============================================================================

# [OPTIONAL] (development) - 'production' disables TypeORM synchronize and
# switches the email service from console logging to a real provider
NODE_ENV=development

# [OPTIONAL] (3000) HTTP port
PORT=3000

# [OPTIONAL] (info; debug when NODE_ENV=development) error|warn|info|debug|verbose
LOG_LEVEL=info

# [OPTIONAL] (http://localhost:4200) Used for OAuth redirects and email links
FRONTEND_URL=http://localhost:4200


# =============================================================================
# AUTHENTICATION (OPTIONAL - JWT lifetimes and social login)
# =============================================================================

# [OPTIONAL] (15m) Access token lifetime
JWT_EXPIRY=15m

# [REQUIRED for refresh tokens] No default - refresh token issuing/verification
# fails without it. Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-in-production

# [OPTIONAL] (7d) Refresh token lifetime
JWT_REFRESH_EXPIRY=7d

# [OPTIONAL] GitHub OAuth login - https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# [OPTIONAL] Google OAuth login - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# [OPTIONAL, but required for per-user GitHub repo listing] 32-byte key (64
# hex chars) encrypting each user's GitHub OAuth access token at rest with
# AES-256-GCM (src/common/token-encryption/token-encryption.service.ts).
# Deliberately a SEPARATE secret from JWT_SECRET/JWT_REFRESH_SECRET so either
# can be rotated without affecting the other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset/malformed, the backend does NOT crash - GitHub OAuth login still
# works, but the token is not persisted, so per-user repo listing falls back
# to the server GITHUB_TOKEN (or is unavailable).
TOKEN_ENCRYPTION_KEY=


# =============================================================================
# RESEARCH (OPTIONAL)
# =============================================================================

# [OPTIONAL] Tavily API key - enables web search during the research phase.
# Without it, web research is skipped. https://tavily.com/
TAVILY_API_KEY=tvly-xxxxx


# =============================================================================
# EMAIL (OPTIONAL - in development emails are logged to the console)
# =============================================================================

# [OPTIONAL] (sendgrid) sendgrid | ses | mailgun
EMAIL_PROVIDER=sendgrid

# [OPTIONAL] Required when NODE_ENV=production and email is used
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# [OPTIONAL] (noreply@mcp-everything.com)
EMAIL_FROM=noreply@mcp-everything.com

# [OPTIONAL] (MCP Everything)
EMAIL_FROM_NAME=MCP Everything


# =============================================================================
# STRIPE / BILLING (OPTIONAL - subscription features are disabled without it)
# See docs/STRIPE_SETUP.md
# =============================================================================

STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Price IDs from the Stripe dashboard
STRIPE_PRICE_FREE=price_xxxxx
STRIPE_PRICE_PRO=price_xxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxx


# =============================================================================
# MCP SERVER HOSTING (OPTIONAL - only needed for the K8s hosting feature)
# =============================================================================

# [OPTIONAL] (ghcr.io) Container registry host
GHCR_REGISTRY=ghcr.io

# [OPTIONAL] No default - required for cloud hosting image pushes
GHCR_OWNER=4eyedengineer

# [OPTIONAL] 'user' or 'org' - whether GHCR_OWNER above is a GitHub user
# account or an organisation. Auto-detected via GET /users/{owner} when unset;
# set it explicitly to skip that lookup. This picks which GitHub Packages API
# is used to delete/inspect images (/user/packages/... vs
# /orgs/{org}/packages/...) - the wrong one always 404s, so image cleanup
# silently never happens.
# GHCR_OWNER_TYPE=org

# [OPTIONAL] (mcp-servers) Registry repository name
GHCR_REPO=mcp-servers

# [OPTIONAL] (4eyedengineer) GitOps repo owner used for K8s manifests
GITOPS_OWNER=4eyedengineer

# [OPTIONAL] (mcp-server-deployments)
GITOPS_REPO=mcp-server-deployments

# [OPTIONAL] (main)
GITOPS_BRANCH=main

# [OPTIONAL] (mcp.example.com) Public domain for hosted MCP servers
MCP_HOSTING_DOMAIN=mcp.example.com

# [OPTIONAL] (mcp-servers) Kubernetes namespace for hosted servers
K8S_NAMESPACE=mcp-servers

# [OPTIONAL] Set to 'true' to use a local KinD cluster + local registry and
# write manifests to disk instead of committing to the GitOps repo
# LOCAL_DEV=true

# [OPTIONAL] (./k8s/local-gitops/servers) Only used when LOCAL_DEV=true
# LOCAL_GITOPS_PATH=./k8s/local-gitops/servers

# [OPTIONAL] (kubernetes) Set to 'docker-run' to run "Host on Cloud" deploys
# as real local Docker containers (build + docker run + verify the MCP
# stdio handshake) instead of push-to-registry + GitOps-commit-for-a-cluster.
# No registry or Kubernetes cluster required. See DEPLOYMENT.md
# "local hosting on WSL2" for what this does and does not prove.
# HOSTING_MODE=docker-run

# [OPTIONAL] (docker) Path to the docker CLI. Only needed if `docker` isn't
# on PATH - e.g. a WSL2 distro with no docker CLI installed, where Windows
# Docker Desktop's client is reachable via the Windows filesystem mount:
# DOCKER_BIN=/mnt/c/Program Files/Docker/Docker/resources/bin/docker.exe

# [OPTIONAL] (15000) Milliseconds to wait for a freshly-started container to
# respond to the initialize/tools-list MCP handshake before treating the
# HOSTING_MODE=docker-run deploy as failed.
# MCP_HANDSHAKE_TIMEOUT_MS=15000


# =============================================================================
# MARKETPLACE ADMIN (OPTIONAL - interim mechanism, see note below)
# =============================================================================

# [OPTIONAL] Comma-separated, case-insensitive list of emails allowed to call
# the marketplace admin endpoints (e.g. PATCH admin/servers/:id - status
# changes, featured toggling). This is an INTERIM allowlist: the User entity
# has no `role` column and no RolesGuard exists elsewhere in the backend to
# reuse. Replace with a real role-based check if/when one is added.
# Example: ADMIN_USER_EMAILS=admin@mcp-everything.local,you@example.com
ADMIN_USER_EMAILS=


# =============================================================================
# HEALTH CHECKS / MISC (OPTIONAL)
# =============================================================================

# [OPTIONAL] (localhost / 6379) Only used by the /api/v1/health Redis probe.
# Nothing else in the backend uses Redis yet.
REDIS_HOST=localhost
REDIS_PORT=6379

# [OPTIONAL] Read by dockerode/docker-modem for MCP server test containers
DOCKER_HOST=unix:///var/run/docker.sock


# =============================================================================
# GENERATED SERVERS (OPTIONAL)
# =============================================================================

# [OPTIONAL] (<cwd>/generated-servers) Directory generated MCP server files are
# written to and read from (pipeline.service.ts, deployment.service.ts,
# local-docker-validator.provider.ts). In the production container image cwd
# is /app, and the Dockerfile provisions /app/generated-servers as writable by
# the nestjs user - do not point this outside of /app in that image.
GENERATED_SERVERS_DIR=./generated-servers


# =============================================================================
# NOT READ BY THE BACKEND (kept here as documentation only)
# -----------------------------------------------------------------------------
# The following variables appeared in earlier versions of this file (or in
# docker-compose) but no backend code reads them. Setting them has NO effect:
#
#   POSTGRES_HOST / POSTGRES_PORT / POSTGRES_USER / POSTGRES_PASSWORD /
#   POSTGRES_DB      -> the app reads DATABASE_* (above). These names are only
#                       consumed by the postgres container itself.
#   DATABASE_URL     -> never parsed by the backend; use DATABASE_* instead.
#   REDIS_URL        -> not parsed; use REDIS_HOST / REDIS_PORT.
#   STRIPE_PUBLISHABLE_KEY -> frontend-only value.
#   DATABASE_SSL / DATABASE_SYNCHRONIZE / DATABASE_LOGGING
#   ANTHROPIC_TEMPERATURE -> not sent; temperature is rejected by current
#                       Claude models. (ANTHROPIC_MODEL / ANTHROPIC_SMALL_MODEL /
#                       ANTHROPIC_MAX_TOKENS *are* read - see CORE above.)
#   GITHUB_BASE_URL / DOCKER_REGISTRY_URL / BUILD_TIMEOUT /
#   MAX_CONCURRENT_BUILDS / DEFAULT_GIST_VISIBILITY / MAX_GIST_SIZE /
#   RATE_LIMIT_TTL / RATE_LIMIT_MAX / JWT_EXPIRES_IN / CORS_ORIGINS /
#   CONTAINER_REGISTRY / MCP_DOMAIN / SKIP_TLS
# =============================================================================
